# AZURE
AZURE_STORAGE_ACCOUNT= xxx
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=forecasting
AZURE_SUBSCRIPTION_ID= xxx
AZURE_RESOURCE_GROUP= xxx
AZURE_ML_WORKSPACE= xxx

# backend cache
DISABLE_BACKEND_CACHE= xxx
BACKEND_CACHE_CONNECTION_STRING= xxx
BACKEND_CACHE_EXPIRATION_TIME= xxx

# Standalone return-forecast service (native PyTorch; no Keras dependency)
FORECAST_STORAGE=local
FORECAST_STORAGE_ROOT=artifacts/storage
FORECAST_MODEL_ROOT=artifacts/models
FORECAST_DATA_ROOT=data/raw
FORECAST_MAX_AGE_DAYS=14
FORECAST_ENV=local
# Set from a secret manager for nonlocal hosting; do not commit an actual key.
FORECAST_API_KEY=

# web urls
BACKEND_URL= xxx
FRONTEND_URL= xxx

# frontend cache
FRONTEND_CACHE_EXPIRATION_TIME= xxx

# model training
MODEL_NAME= xxx
WINDOW_SIZE= xxx
MODEL_LOCATION= LOCAL | AZURE
MODEL_EVAL_THRESHHOLD= xxx

# Langsmith API key
LANGSMITH_API_KEY= xx

# API keys for google gemini models
GOOGLE_API_KEY= xx
GOOGLE_API_KEY_1= xx

# LLM model and embedding model names
GENERATIVE_MODEL= xxx # used by the generative agents
SIMPLE_TASK_MODEL= xxx #used by other RAG agents
EMBEDDING_MODEL= xxx # e.g., models/text-embedding-004

# user agent for the RAG web search tool (set this value to avoid warning messages)
USER_AGENT= DefaultLangchainUserAgent # Default user agent for the RAG web search tool

# Pinecone API key and index name
PINECONE_API_KEY= xx
INDEX_NAME=  xx

# Email Notification Settings
SMTP_SERVER= xxx
SMTP_PORT= xxx
SMTP_SENDER_EMAIL= xxx
SMTP_SENDER_PASSWORD= xxx
EMAIL_RECIPIENT= xxx

# Web search. Optional: without it the assistant works from the stored news
# archive alone, and simply reports that searching is unavailable.
TAVILY_API_KEY= xxx

# RAG assistant
AGENT_MAX_RETRIES= 2      # how many times a poor answer is retried before it is returned anyway
CHECKPOINTER_BACKEND= memory  # where conversation history is kept; only "memory" is implemented
