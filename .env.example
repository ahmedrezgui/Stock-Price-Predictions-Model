# Forecast service and data
FORECAST_STORAGE=local
FORECAST_STORAGE_ROOT=artifacts/storage
FORECAST_MODEL_ROOT=artifacts/models
FORECAST_DATA_ROOT=data/raw
FORECAST_MAX_AGE_DAYS=14
FORECAST_ENV=local
FORECAST_API_KEY=

# LangGraph assistant: gemini | ollama | azure
ASSISTANT_PROVIDER=gemini
# Choose a model available to your account; Azure uses the deployment name.
ASSISTANT_MODEL=gemini-2.5-flash
# Blank uses ASSISTANT_MODEL.
ASSISTANT_SIMPLE_MODEL=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ASSISTANT_URL=http://127.0.0.1:8001
# Remote forecasting API base URL (/v1/predict contract); no implicit local fallback.
ASSISTANT_FORECAST_URL=
ASSISTANT_DATA_ROOT=data/raw
ASSISTANT_RECURSION_LIMIT=40
AGENT_MAX_RETRIES=2
CHECKPOINTER_BACKEND=memory

# MLflow GenAI tracing, separate from the training experiment
ASSISTANT_TRACING_ENABLED=true
ASSISTANT_MLFLOW_EXPERIMENT=stock-assistant
# Blank uses repository-root mlflow-assistant.db.
ASSISTANT_MLFLOW_TRACKING_URI=
# Training uses its own database; assistant URI can explicitly point to a shared server.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=stock-return-forecasting

# Provider alternatives (install the corresponding package extra)
OLLAMA_BASE_URL=http://localhost:11434
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Optional news search and archive retrieval
TAVILY_API_KEY=
PINECONE_API_KEY=
INDEX_NAME=
EMBEDDING_MODEL=
USER_AGENT=StockWise

# Azure training/storage (not LLM API credentials)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=forecasting
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=

# Existing dashboard and legacy model/scaler workflow
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8501
DISABLE_BACKEND_CACHE=true
BACKEND_CACHE_CONNECTION_STRING=
BACKEND_CACHE_EXPIRATION_TIME=300
FRONTEND_CACHE_EXPIRATION_TIME=300
MODEL_NAME=LSTM
WINDOW_SIZE=20
MODEL_LOCATION=LOCAL
MODEL_EVAL_THRESHHOLD=
# Gemini compatibility settings; prefer ASSISTANT_MODEL for new work.
GENERATIVE_MODEL=
SIMPLE_TASK_MODEL=
GOOGLE_API_KEY_1=
LANGSMITH_API_KEY=

# Optional existing email notifications
SMTP_SERVER=
SMTP_PORT=
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
EMAIL_RECIPIENT=
